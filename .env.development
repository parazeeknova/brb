NODE_ENV=development
LOG_LEVEL=INFO
PORT=3002
HOST=0.0.0.0
GENERALCOMPUTE_MODEL=minimax-m2.7
LLM_FALLBACK_MODELS=deepseek-v3.1,deepseek-v3.2
LLM_PER_CALL_TIMEOUT_S=15
EMBED_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBED_MODEL=gemini-embedding-2

RADAR_SESSION_APPLICATION_TARGET=0
DISCOVERY_SOURCE=all

# Throughput tuning.
MAX_SCRAPE_WORKERS=36
MATCH_CONCURRENCY=24
VERIFY_CONCURRENCY=20
SCHEDULER_WORKERS=8
MAX_QUEUE_SIZE=1000
LLM_QUEUE_MAX_IN_FLIGHT=10
LLM_QUEUE_RPM=90
LLM_QUEUE_TPM=180000
LLM_QUEUE_MATCH_TOKENS=2000
HTTP_MAX_CONNECTIONS=200
HTTP_DEFAULT_TIMEOUT=45
FIRECRAWL_TIMEOUT=90
RADAR_HIGH_FREQ_POLL=120
SWEEP_INTERVAL=120
LLM_BUDGET_RADAR_RPM=60
LLM_BUDGET_RADAR_TPM=120000

# Local infra pointers (match docker/docker-compose.yml).
SEARXNG_URL=http://localhost:8080/search
SEARXNG_SECRET=changeme
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5443/agent_memory
LLM_BUDGET_REDIS_URL=redis://127.0.0.1:6380/1
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
TOR_EXIT_COUNTRY=IN
