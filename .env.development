NODE_ENV=development
LOG_LEVEL=INFO
PORT=3002
HOST=0.0.0.0
GENERALCOMPUTE_MODEL=minimax-m2.7
LLM_FALLBACK_MODELS=deepseek-v3.1,deepseek-v3.2
LLM_PER_CALL_TIMEOUT_S=15
EMBED_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBED_MODEL=gemini-embedding-2

# Corpus scope: all roles, levels, and functions (junior -> staff,
# engineering -> design -> data -> everything). No seniority gating.
DISCOVERY_SOURCE=all

# Throughput tuning (continuous pipeline: consumers per stage, stream caps).
FETCH_WORKERS=24
NORMALIZE_WORKERS=16
EMBED_WORKERS=4
ENRICH_WORKERS=2
# Discovery/enrichment budgets (free tiers: TinyFish search 12k/day).
PRODUCER_TINYFISH_INTERVAL_S=60
TINYFISH_SEARCH_PER_TICK=8
SUBQ_MODEL=subq-snap-preview
STREAM_MAXLEN=5000
STREAM_BLOCK_MS=5000
HTTP_MAX_CONNECTIONS=200
HTTP_DEFAULT_TIMEOUT=45
FIRECRAWL_TIMEOUT=90

# Observability (local OpenObserve; SDKs append /v1/logs|traces|metrics).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5090/api/default
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123

# Local infra pointers (match docker/docker-compose.yml).
SEARXNG_URL=http://localhost:8080/search
SEARXNG_SECRET=changeme
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5443/agent_memory
POSTGRES_MIN_POOL=4
POSTGRES_MAX_POOL=64
SUBQ_TIMEOUT_S=10
STREAMS_REDIS_URL=redis://127.0.0.1:6380/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
TOR_EXIT_COUNTRY=IN
