{
  "name": "@ho/db",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Postgres contract (Prisma 8) for the ho corpus. Ingest writes via SQL; this is the read contract for the web app. Never migrate/push against the corpus database.",
  "scripts": {
    "contract:emit": "prisma contract emit",
    "contract:format": "prisma contract format",
    "contract:infer": "prisma contract infer --db $DATABASE_URL",
    "lint": "oxlint",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.9-dev.13",
    "dotenv": "^17.3.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "8.0.0-rc.2",
    "@types/node": "^26.6.5",
    "prisma": "8.0.0-rc.9",
    "typescript": "^7.0.2"
  }
}
