{
  "name": "@brb/db",
  "version": "0.1.2",
  "private": true,
  "description": "Shared Postgres corpus contract and reviewed Prisma 8 migrations. Ingest retains its private operational tables and vector columns.",
  "scripts": {
    "contract:emit": "prisma contract emit",
    "contract:format": "prisma contract format",
    "contract:infer": "prisma contract infer --db $DATABASE_URL",
    "lint": "oxlint",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "prisma contract emit && prisma migration check && prisma db migrate --show --from @empty --to @contract",
    "db:plan": "prisma migration plan",
    "db:check": "prisma migration check",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:verify": "prisma db verify"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "dotenv": "^17.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "8.0.0-rc.27",
    "typescript": "^7.0.2"
  }
}
