// use prisma-8
model JobObservation {
  urlHash               String   @id @map("url_hash")
  url                   String
  source                String   @default("")
  title                 String   @default("")
  snippet               String   @default("")
  firstSeen             Float    @default(0) @map("first_seen")
  lastSeen              Float    @default(0) @map("last_seen")
  freshnessLane         String   @default("review") @map("freshness_lane")
  directPostingVerified Boolean  @default(false) @map("direct_posting_verified")
  rawJson               Json     @default("{}") @map("raw_json")
  verified              Boolean  @default(false)
  verificationMethod    String   @default("") @map("verification_method")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("job_observations")
}

model RadarCandidate {
  canonicalId          String   @id @map("canonical_id")
  source               String   @default("")
  directApplyUrl       String   @default("") @map("direct_apply_url")
  normalizedCompany    String   @default("") @map("normalized_company")
  normalizedRole       String   @default("") @map("normalized_role")
  normalizedLocation   String   @default("Remote") @map("normalized_location")
  freshnessLane        String   @default("review") @map("freshness_lane")
  sourceConfidence     Float    @default(0.5) @map("source_confidence")
  eligibility          String   @default("pending")
  rejectionReason      String   @default("") @map("rejection_reason")
  rejectionDetail      String   @default("") @map("rejection_detail")
  roleFamily           String   @default("unknown") @map("role_family")
  salaryAmount         Float?   @map("salary_amount")
  salaryCurrency       String   @default("") @map("salary_currency")
  salaryPeriod         String   @default("") @map("salary_period")
  salaryRaw            String   @default("") @map("salary_raw")
  postedDate           String   @default("") @map("posted_date")
  firstSeen            Float    @default(0) @map("first_seen")
  lastSeen             Float    @default(0) @map("last_seen")
  matchingSkills       Json     @default("[]") @map("matching_skills")
  missingSkills        Json     @default("[]") @map("missing_skills")
  matchPercent         Int      @default(0) @map("match_percent")
  shortlistProbability Int      @default(0) @map("shortlist_probability")
  verdict              String   @default("NO_MATCH")
  jdSummary            String   @default("") @map("jd_summary")
  companyDescription   String   @default("") @map("company_description")
  roleSummary          String   @default("") @map("role_summary")
  isRemote             Boolean  @default(false) @map("is_remote")
  founders             Json     @default("[]")
  fundingStage         String   @default("") @map("funding_stage")
  fundingInfo          Json     @default("{}") @map("funding_info")
  founderSocials       Json     @default("[]") @map("founder_socials")
  companyNews          String   @default("") @map("company_news")
  osintSignals         Json     @default("[]") @map("osint_signals")
  extra                Json     @default("{}")
  verified             Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @map("updated_at")

  @@map("radar_candidates")
}

model ObsEmbedding {
  urlHash     String   @id @map("url_hash")
  title       String   @default("")
  company     String   @default("")
  contentHash String   @default("") @map("content_hash")
  embeddedAt DateTime @default(now()) @map("embedded_at")

  @@map("obs_embeddings")
}

model SourceCheckpoint {
  sourceId            String   @id @map("source_id")
  sourceType          String   @default("unknown") @map("source_type")
  boardUrl            String   @default("") @map("board_url")
  lastPolled          Float    @default(0) @map("last_polled")
  lastSnapshotHash    String   @default("") @map("last_snapshot_hash")
  lastSnapshotCount   Int      @default(0) @map("last_snapshot_count")
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  consecutiveEmpty    Int      @default(0) @map("consecutive_empty")
  qualityScore        Float    @default(0.5) @map("quality_score")
  active              Boolean  @default(true)
  backoffUntil        Float    @default(0) @map("backoff_until")
  totalJobsProduced   Int      @default(0) @map("total_jobs_produced")
  totalDirectUrlRate  Float    @default(0) @map("total_direct_url_rate")
  companyName         String   @default("") @map("company_name")
  discoveryOrigin     String   @default("") @map("discovery_origin")
  pollLane            String   @default("high") @map("poll_lane")
  yieldPerPoll        Float    @default(0) @map("yield_per_poll")
  lastChangeAt        Float    @default(0) @map("last_change_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  @@map("source_checkpoints")
}
