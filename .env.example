# brb environment — how it layers (see scripts/dev.py):
# .env.development (committed defaults) < .env (this file, secrets win) < shell.

# LLM (GeneralCompute, intel scripts + verifier)
GENERALCOMPUTE_API_KEY=

# Embeddings via Gemini (required for semantic search)
GEMINI_API_KEY=

# TinyFish web search + fetch (discovery producers, enrichment, JS fallback)
TINY_FISH_API_KEY=

# SubQ decisions (subq-snap-preview via /v1/systemone verification judgments)
SUBQ_API_KEY=

# --- Infrastructure secrets (all required by docker compose, none defaulted) ---
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
REDIS_PASSWORD=
SEARXNG_SECRET=
ZO_ROOT_USER_EMAIL=root@example.com
# OpenObserve root password policy: 8-128 chars with lower + UPPER + digit + special
ZO_ROOT_USER_PASSWORD=

# --- Optional sources (skipped silently when unset) ---
# USAJobs API (free at https://api.data.gov/signup)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
